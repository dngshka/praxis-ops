# systemd USER unit. Install to ~/.config/systemd/user/ for the praxis-sbx user.
# Requires `loginctl enable-linger praxis-sbx`.
[Unit]
Description=Praxis sandbox orchestrator
Requires=podman.socket
After=podman.socket

[Service]
Type=simple
# Point at whichever rootless socket you settled on. %t is already absolute
# (/run/user/<uid>), so this needs unix:// (the scheme delimiter), not unix: --
# unix:%t/... collapses to a single slash after the colon, which the docker
# client's own URL parser rejects outright ("unable to parse docker host").
#   podman:  unix://%t/podman/podman.sock
#   docker:  unix://%t/docker.sock
Environment=DOCKER_HOST=unix://%t/podman/podman.sock
Environment=PRAXIS_LISTEN=127.0.0.1:8081
# Weight budget, not a flat container count -- PRAXIS_MAX_CONCURRENT is
# retired (Stage 4, docs/observability.md "Weighted admission"). Every
# current ticket leaves Runbook.Weight unset, which EffectiveWeight()
# treats as 1, so this is a flat concurrent-sandbox count until a second
# ticket sets a real weight.
# 35 = ~70% of CPT-01's real measured staircase ceiling (50), the heavier
# of the two real tickets -- see docs/capacity-benchmark.md's "Phase D
# close-out" section, 2026-09-05/06. CPT-01 is disk-bound (praxis-sbx's
# storage volume), SJN-01 is bound by an unrelated podman/containers-
# storage userns/idmap internals limit (~60) that sits above this value,
# so sizing against CPT-01 keeps both tickets within their own real
# ceilings. Replaces 2 (guess) and 11 (measured against bare ops-base,
# not a real ticket -- see the superseded 2026-09-03 entry in
# docs/capacity-benchmark.md). Re-benchmark if the storage volume is ever
# resized, or if a future ticket proves heavier than CPT-01.
Environment=PRAXIS_CAPACITY_WEIGHT=35
Environment=PRAXIS_REAP_INTERVAL=30
Environment=PRAXIS_EXEC_TIMEOUT=120
# Runbook.shared_from_image: <dir>/<image id>/<path> copies of image trees,
# served read-only (docs/capacity-benchmark.md, 2026-09-27). Written by the
# operator's image loader; a missing dir or copy only means the sandbox runs
# from its image. Remove the line to switch the feature off.
Environment=PRAXIS_SHARED_DIR=%h/shared
# Shared secret with the portal. Keep it out of the unit file in anything but a POC.
EnvironmentFile=%h/.config/praxis/orchestrator.env

ExecStart=%h/bin/orchestrator
Restart=always
RestartSec=5

# The orchestrator itself needs no privileges beyond its own socket.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=%h/.local/share/containers %t

[Install]
WantedBy=default.target
